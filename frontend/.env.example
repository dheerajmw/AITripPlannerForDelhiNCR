# Copy to .env.local for local dev, or set in Vercel → Project → Settings → Environment Variables.
#
# Vercel import: leave Root Directory as repo root (vercel.json builds frontend/).
# Alternative: set Root Directory to `frontend` and remove install/build overrides from root vercel.json.

# --- API (production on Vercel) ---
# Server-side rewrite target for /api/v1/* → backend (see next.config.ts).
# Required on Vercel unless you set NEXT_PUBLIC_API_URL instead.
API_PROXY_TARGET=https://your-backend.example.com

# Optional: call the API directly from the browser (skip Next.js proxy).
# If set, add your Vercel URL to backend CORS_ORIGINS.
# NEXT_PUBLIC_API_URL=https://your-backend.example.com/api/v1

# --- Maps (optional) ---
# Itinerary map degrades gracefully without this key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
